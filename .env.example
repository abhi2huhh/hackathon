FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=YOUR_SECRET_KEY_HERE
JWT_SECRET_KEY=YOUR_JWT_SECRET_HERE
JWT_ACCESS_TOKEN_EXPIRES=86400

# Use PostgreSQL/SQLAlchemy for the current app.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/seamless_learning

# Optional MongoDB Atlas config for future auth/data migration.
MONGODB_URI=mongodb+srv://<atlas-user>:<atlas-password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority
MONGODB_DB_NAME=innolearn

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

LLM_PROVIDER=together
TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY_HERE
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.together.xyz/v1

RAG_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
EMBEDDING_MODEL_NAME=Alibaba-NLP/gte-base-en-v1.5
ABSTRACTIVE_MODEL_NAME=facebook/bart-large-cnn

CLOUDINARY_CLOUD_NAME=YOUR_VALUE
CLOUDINARY_API_KEY=YOUR_VALUE
CLOUDINARY_API_SECRET=YOUR_VALUE

# Frontend local dev and production origin(s) for CORS.
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads

# Vercel frontend environment variable.
VITE_API_URL=http://localhost:5000/api

# Render backend URL example:
# VITE_API_URL=https://your-backend-name.onrender.com/api
